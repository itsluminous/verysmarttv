<?xml version="1.0" encoding="utf-8"?>
<!-- SelectableText: a TV has no text selection; the texts are read, not copied. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SelectableText"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="36dp"
    android:paddingEnd="48dp"
    android:paddingBottom="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView style="@style/Title" android:text="@string/title_scores" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/followPill" style="@style/Pill" android:text="@string/follow" android:layout_marginEnd="10dp" />
        <TextView android:id="@+id/settingsPill" style="@style/Pill" android:text="@string/settings" />
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textSize="13sp" android:textColor="#80FFFFFF" />
    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="18dp"
        android:scrollbars="none" android:overScrollMode="never" android:clipToPadding="false" android:paddingBottom="24dp">
        <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
    <LinearLayout android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/empty_followed" android:textSize="22sp" android:textColor="#FFFFFFFF" />
        <TextView android:layout_width="520dp" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="@string/empty_hint" android:textSize="14sp" android:textColor="#99FFFFFF" />
    </LinearLayout>
</LinearLayout>
