<?xml version="1.0" encoding="utf-8"?>
<!-- SelectableText: a TV has no text selection; the texts are read, not copied. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SelectableText"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/row_bg">
    <TextView android:id="@+id/sideName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:textColor="#FFFFFFFF" />
    <TextView android:id="@+id/sideScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="32sp" android:textColor="#FFFFFFFF" />
    <LinearLayout android:id="@+id/sideInnings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" />
</LinearLayout>
