<?xml version="1.0" encoding="utf-8"?>
<!-- SelectableText: a TV has no text selection; the texts are read, not copied. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SelectableText"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">
    <TextView android:id="@+id/primary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#FFFFFFFF" />
    <TextView android:id="@+id/secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:textSize="15sp" android:textColor="#99FFFFFF" />
</LinearLayout>
