<?xml version="1.0" encoding="utf-8"?>
<!-- SelectableText: a TV has no text selection; the texts are read, not copied. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SelectableText"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@drawable/row_bg">
    <TextView android:id="@+id/tick" android:layout_width="24dp" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#FFFFFFFF" />
    <TextView android:id="@+id/label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp"
        android:textSize="15sp" android:textColor="#FFFFFFFF" android:singleLine="true" android:ellipsize="end" />
</LinearLayout>
