<?xml version="1.0" encoding="utf-8"?>
<!-- score_line_bg while the hero_feed backdrop is up behind the top bar: the same 10% white shade over a dark base,
     as pill_bg_over_art darkens the round pills, so the white line still reads over a bright sky. The focused state
     is score_line_bg's. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3DFFFFFF" android:endColor="#1FFFFFFF" />
            <stroke android:width="1.5dp" android:color="#E6FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#66000000" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1AFFFFFF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
