<?xml version="1.0" encoding="utf-8"?>
<!-- pill_bg while the hero_feed backdrop is up behind the top bar: the same frost over a dark base, so the white
     icons still read over a bright backdrop. The focused and activated states are pill_bg's. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#66000000" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#14FFFFFF" />
                    <stroke android:width="1dp" android:color="#38FFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
