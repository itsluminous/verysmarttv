<?xml version="1.0" encoding="utf-8"?>
<!-- One line of the score pill (DESIGN.md §9.2, ADR-041): at rest a 10% white shade with rounded ends, so the line
     reads on the black background and on a wallpaper alike; while focused the round pills' frost with a white ring,
     the glass focus ring, the text staying white over it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3DFFFFFF" android:endColor="#1FFFFFFF" />
            <stroke android:width="1.5dp" android:color="#E6FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
