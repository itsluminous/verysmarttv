<?xml version="1.0" encoding="utf-8"?>
<!-- One line of the score pill (DESIGN.md §9.2, ADR-041, ADR-042): a row on its own rounded shade (score_line_bg; the
     frosted ring while focused) holding the text and the sport icon of score_line_content.xml, which the view inflates
     into itself. ScorePill inflates one per row it shows. -->
<com.itsluminous.verysmarttv.topbar.ScoreLineView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="end"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:background="@drawable/score_line_bg"
    android:focusable="true"
    android:clickable="true" />
