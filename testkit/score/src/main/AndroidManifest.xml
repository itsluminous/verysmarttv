<?xml version="1.0" encoding="utf-8"?>
<!-- The live-score companion stand-in for the launcher's instrumentation tests (DESIGN.md §14.3, ADR-037). The two
     permissions and the provider carry the companion's own names (ScoreContract): the launcher's uses-permission
     entries are satisfied by this package's definitions, under this package's signature. No activity and no leanback
     feature: it is a provider, not an app anyone opens; the pill's OK intent is caught in-process by the tests. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The companion's names for them (ScoreContract.PERMISSION_READ, PERMISSION_WRITE), not this module's namespace:
         lint's naming rule wants the namespace, and the launcher asks for these exact names. -->
    <permission
        android:name="com.itsluminous.livescore.permission.READ_SCORES"
        android:protectionLevel="signature"
        tools:ignore="PermissionNamingConvention" />
    <permission
        android:name="com.itsluminous.livescore.permission.WRITE_SCORES"
        android:protectionLevel="signature"
        tools:ignore="PermissionNamingConvention" />

    <!-- allowBackup false as the companion: the stand-in holds nothing. DataExtractionRules is the same finding the
         companion and the launcher carry in their baselines; a new module may not baseline, so it is named here. -->
    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:allowBackup="false"
        tools:ignore="DataExtractionRules">
        <!-- Seeds ScoreFixture's live row when the system creates it; a test switches the row with
             call("fixture", name). readPermission for the queries, writePermission for call("restore"), as the real
             provider (§12.3). -->
        <provider
            android:name=".FixtureScoreProvider"
            android:authorities="com.itsluminous.livescore.scores"
            android:exported="true"
            android:readPermission="com.itsluminous.livescore.permission.READ_SCORES"
            android:writePermission="com.itsluminous.livescore.permission.WRITE_SCORES"
            android:grantUriPermissions="false" />
    </application>
</manifest>
