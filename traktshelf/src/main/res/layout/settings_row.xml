<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:orientation="vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@drawable/row_bg">
    <TextView android:id="@+id/rowName" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="16sp" android:textColor="#FFFFFFFF" />
    <TextView android:id="@+id/rowValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:textSize="13sp" android:textColor="#99FFFFFF" />
</LinearLayout>
